default_platform(:ios)

platform :ios do

  desc "Build and upload to TestFlight"
  lane :beta do

    # On CI, create a temporary keychain with the right partition list so that
    # codesign (incl. the Pods "Embed Pods Frameworks" phase) never blocks on a
    # keychain-access prompt. Without this the archive hangs at codesign.
    setup_ci

    # APP_STORE_CONNECT_API_KEY_CONTENT must be the RAW .p8 file content
    # (including -----BEGIN PRIVATE KEY----- lines), NOT base64-encoded.
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false,
    )

    # CI must not create a fresh Apple Distribution certificate on every run.
    # Normal builds use the encrypted match repository in read-only mode.
    # A one-time writable bootstrap can be requested manually from GitHub
    # Actions with the `bootstrap_signing` checkbox.
    bootstrap_signing = ENV["FACEMAX_MATCH_BOOTSTRAP"] == "1"
    UI.message("Code signing mode: #{bootstrap_signing ? 'BOOTSTRAP (write)' : 'READONLY'}")

    match(
      type: "appstore",
      app_identifier: "ai.facemax.app",
      readonly: !bootstrap_signing,
      force: false,
      generate_apple_certs: true,
      git_url: ENV.fetch(
        "MATCH_GIT_URL",
        "https://github.com/maks200r1-png/facemax-ai-cert.git",
      ),
      git_branch: ENV.fetch("MATCH_GIT_BRANCH", "main"),
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      api_key: api_key,
    )

    # match installs the profile under its actual portal name (which may carry a
    # timestamp suffix). Point the project's manual signing at exactly that name
    # so the archive step can resolve it regardless of the hard-coded value.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      bundle_identifier: "ai.facemax.app",
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_ai.facemax.app_appstore_profile-name"],
      targets: ["App"],
    )

    # Keep the CI/TestFlight marketing version explicit and in sync with the workflow.
    marketing_version = ENV.fetch("APP_MARKETING_VERSION", "1.8")
    UI.message("Marketing version: #{marketing_version}")

    increment_version_number(
      version_number: marketing_version,
      xcodeproj: "App.xcodeproj",
    )

    latest_build = latest_testflight_build_number(
      app_identifier: "ai.facemax.app",
      api_key: api_key,
      initial_build_number: 0,
    )

    increment_build_number(
      build_number: latest_build + 1,
      xcodeproj: "App.xcodeproj",
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "FaceMax.ipa",
      clean: true,
      xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} CODE_SIGN_STYLE=Manual",
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/FaceMax.ipa",
      skip_waiting_for_build_processing: true,
    )

    UI.success "✅ Успешно загружено в TestFlight!"
  end


  desc "One-time: revoke and recreate App Store signing assets"
  lane :reset_appstore_signing do
    setup_ci

    # setup_ci enables MATCH_READONLY globally. That is correct for normal CI
    # builds, but a signing reset must be allowed to revoke and write assets.
    ENV["MATCH_READONLY"] = "false"
    UI.message("Signing reset mode: WRITE (MATCH_READONLY=false)")

    confirmation = ENV["FACEMAX_SIGNING_RESET_CONFIRM"].to_s
    unless confirmation == "DELETE_AND_RECREATE"
      UI.user_error!("Refusing signing reset: FACEMAX_SIGNING_RESET_CONFIRM must equal DELETE_AND_RECREATE")
    end

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false,
    )

    signing_repo = ENV.fetch(
      "MATCH_GIT_URL",
      "https://github.com/maks200r1-png/facemax-ai-cert.git",
    )
    signing_branch = ENV.fetch("MATCH_GIT_BRANCH", "main")

    UI.important("Revoking App Store distribution signing assets for ai.facemax.app")

    match_nuke(
      type: "appstore",
      app_identifier: "ai.facemax.app",
      team_id: ENV["APPLE_TEAM_ID"],
      api_key: api_key,
      git_url: signing_repo,
      git_branch: signing_branch,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      readonly: false,
      skip_confirmation: true,
    )

    UI.message("Creating one fresh Apple Distribution certificate and App Store profile")

    match(
      type: "appstore",
      app_identifier: "ai.facemax.app",
      readonly: false,
      force: false,
      generate_apple_certs: true,
      git_url: signing_repo,
      git_branch: signing_branch,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      api_key: api_key,
    )

    UI.success("Signing reset complete. Future builds must use readonly mode.")
  end

end